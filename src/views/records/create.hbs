<div class="page">
  <div class="page-header">
    <h2>Add Fuel Record</h2>
  </div>

  <div class="card" style="max-width:560px;">
    {{#if error}}
    <div class="alert alert-error">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      {{error}}
    </div>
    {{/if}}

    <form method="POST" action="/records/create">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">

      <div class="form-grid">
        <div class="form-group">
          <label for="date">Date</label>
          <input type="date" id="date" name="date" value="{{input.date}}" required>
        </div>

        <div class="form-group">
          <label for="vehicleType">Vehicle Type</label>
          <select id="vehicleType" name="vehicleType" required>
            <option value="">Select type…</option>
            <option value="Car" {{#if (eq input.vehicleType "Car")}}selected{{/if}}>Car</option>
            <option value="Motorcycle" {{#if (eq input.vehicleType "Motorcycle")}}selected{{/if}}>Motorcycle</option>
          </select>
        </div>

        <div class="form-group">
          <label for="liters">Liters (L)</label>
          <input type="number" id="liters" name="liters" step="0.01" min="0.01" value="{{input.liters}}" placeholder="e.g. 40.5" required>
        </div>

        <div class="form-group">
          <label for="distanceKm">Distance (km)</label>
          <input type="number" id="distanceKm" name="distanceKm" step="0.01" min="0.01" value="{{input.distanceKm}}" placeholder="e.g. 450" required>
        </div>

        <div class="form-group">
          <label for="totalCost">Total Cost ($)</label>
          <input type="number" id="totalCost" name="totalCost" step="0.01" min="0.01" value="{{input.totalCost}}" placeholder="e.g. 65.00" required>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-success">Save Record</button>
        <a href="/records" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</div>
