<!-- Dashboard view displaying all fuel records for the logged-in user -->
<div class="container">
  <h2>Welcome, {{username}}</h2>
  <a href="/records/create">+ Add Record</a>

  {{#if hasRecords}}
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Vehicle Type</th>
          <th>Liters</th>
          <th>Distance (km)</th>
          <th>Efficiency (km/L)</th>
          <th>Total Cost</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each records}}
          <tr>
            <td>{{this.dateFormatted}}</td>
            <td>{{this.vehicleType}}</td>
            <td>{{this.liters}}</td>
            <td>{{this.distanceKm}}</td>
            <td>{{this.efficiency}}</td>
            <td>{{this.totalCost}}</td>
            <td>
              <a href="/records/{{this.id}}/edit">Edit</a>
              <form method="POST" action="/records/{{this.id}}/delete" style="display:inline;">
                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                <button type="submit" onclick="return confirm('Delete this record?')">Delete</button>
              </form>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p>No records yet. Add your first fuel record above.</p>
  {{/if}}
</div>
